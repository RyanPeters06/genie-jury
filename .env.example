# Server-side secrets (never shipped to the browser). Copy to .env.local and fill in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_EMBER_VOICE_ID=
ELEVENLABS_GALE_VOICE_ID=
ELEVENLABS_TIDE_VOICE_ID=
ELEVENLABS_VOLT_VOICE_ID=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
PORT=8790

# The only value the browser bundle can see.
VITE_JURY_API_URL=http://127.0.0.1:8790
